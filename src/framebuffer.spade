// Triple-buffered RGB565 framebuffer in SDRAM: 320x240, or 640x480 drawn as
// alternating checkerboard halves.
//
// SDRAM layout: line y of buffer b (0..2) is row {b, y} of bank 0, 160 words
// of two pixels (the lower ray index in the low half). A 320x240 line holds
// all its pixels; a 640x480 checkerboard line holds the 320 pixels of its
// phase (x = 2k + o).
//
// The three buffers rotate through three roles: the renderer draws into one,
// scanout shows the front one and, in quality mode, also reads the previous
// frame, whose opposite checkerboard phase fills the other half of each
// line. The buffers rotate when scanout asks for line 0 (during vertical
// blanking), but only once the renderer has finished a frame, so the picture
// never tears. Scanout asks for source line n ahead of time; it is copied
// into scanout slot n & 1 of the front and previous line buffers.

use lib::sdram::Request;

pub struct FbOut {
    req: Option<Request>,
    // Write into a scanout line buffer: (address {previous?, slot, column}, word).
    scan_write: Option<(uint<10>, uint<32>)>,
    // Render line-buffer slot the SDRAM controller is reading from.
    wbuf_slot: uint<1>,
    slot_free: [bool; 2],
    // The renderer may begin a new frame.
    may_start: bool,
    // The front buffer holds a 640x480 checkerboard frame, its phase, and
    // whether the previous buffer holds the other phase (so the two merge).
    front_quality: bool,
    front_phase: bool,
    merge: bool,
}

enum Inflight {
    Nothing,
    Read{slot: uint<1>, part: uint<1>},
    Write{slot: uint<1>},
}

fn buf_row(buffer: uint<2>, y: uint<9>) -> uint<11> { buffer.concat(y) }

// The buffer that is neither a nor b.
fn third(a: uint<2>, b: uint<2>) -> uint<2> {
    if a != 0 && b != 0 { 0 } else if a != 1 && b != 1 { 1 } else { 2 }
}

struct Meta {
    valid: bool,
    quality: bool,
    phase: bool,
}

fn set_meta(m: [Meta; 3], i: uint<2>, en: bool, v: Meta) -> [Meta; 3] {
    [if en && i == 0 { v } else { m[0] }, if en && i == 1 { v } else { m[1] }, if en && i == 2 { v } else { m[2] }]
}

pub entity framebuffer(
    clk: clock,
    rst: bool,
    scan_req: Option<uint<9>>,
    // A render slot holds a finished line: (slot, y).
    line_done: Option<(uint<1>, uint<9>)>,
    frame_begin: bool,
    // Mode and checkerboard phase of the frame being rendered (stable once it has begun).
    render_quality: bool,
    render_phase: bool,
    accept: bool,
    write_done: bool,
    fill: Option<(uint<8>, uint<32>)>,
) -> FbOut {
    decl front, prev, meta, rendering, frame_done, lines_written, scan_pending, wpend0, wpend1,
        next_wslot, inflight;

    let rbuf = third(front, prev);
    let mf = match front { 0 => meta[0], 1 => meta[1], _ => meta[2] };
    let mp = match prev { 0 => meta[0], 1 => meta[1], _ => meta[2] };
    let merge = mf.valid && mf.quality && mp.valid && mp.quality && mp.phase != mf.phase;

    let is_idle = match inflight { Inflight::Nothing => true, _ => false };
    let wpend_next = if next_wslot == 0 { wpend0 } else { wpend1 };

    // At most one request is offered at a time; scanout wins.
    let req = if !is_idle {
        None
    } else {
        match scan_pending {
            Some((line, part)) => Some(Request$(write: false, bank: 0, row: buf_row(if part == 0 { front } else { prev }, line))),
            None => match wpend_next {
                Some(y) => Some(Request$(write: true, bank: 0, row: buf_row(rbuf, y))),
                None => None,
            },
        }
    };
    let accept_read = accept && scan_pending.is_some();
    let accept_write = accept && !scan_pending.is_some();

    let (scan_line, scan_part): (uint<9>, uint<1>) = match scan_pending { Some(p) => p, None => (0, 0) };
    let scan_slot: uint<1> = trunc(scan_line);
    let last_fill = match fill { Some((col, _)) => col == 159, None => false };

    reg(clk) inflight reset(rst: Inflight::Nothing) = if accept_read {
        Inflight::Read(scan_slot, scan_part)
    } else if accept_write {
        Inflight::Write(next_wslot)
    } else {
        match inflight {
            Inflight::Read(_, _) => if last_fill { Inflight::Nothing } else { inflight },
            Inflight::Write(_) => if write_done { Inflight::Nothing } else { inflight },
            Inflight::Nothing => inflight,
        }
    };

    let swap = match scan_req { Some(line) => line == 0 && frame_done, None => false };
    reg(clk) front: uint<2> reset(rst: 0) = if swap { rbuf } else { front };
    reg(clk) prev: uint<2> reset(rst: 1) = if swap { front } else { prev };

    // A quality line also needs the previous frame's line, when it merges.
    reg(clk) scan_pending: Option<(uint<9>, uint<1>)> reset(rst: None) = match scan_req {
        Some(line) => Some((line, 0)),
        None => if accept_read {
            if mf.quality && merge && scan_part == 0 { Some((scan_line, 1)) } else { None }
        } else {
            scan_pending
        },
    };

    let line_slot0 = match line_done { Some((s, y)) => if s == 0 { Some(y) } else { None }, None => None };
    let line_slot1 = match line_done { Some((s, y)) => if s == 1 { Some(y) } else { None }, None => None };
    let take0 = accept_write && next_wslot == 0;
    let take1 = accept_write && next_wslot == 1;
    reg(clk) wpend0: Option<uint<9>> reset(rst: None) = match line_slot0 {
        Some(y) => Some(y),
        None => if take0 { None } else { wpend0 },
    };
    reg(clk) wpend1: Option<uint<9>> reset(rst: None) = match line_slot1 {
        Some(y) => Some(y),
        None => if take1 { None } else { wpend1 },
    };

    let wrote_line = match inflight { Inflight::Write(_) => write_done, _ => false };
    reg(clk) next_wslot: uint<1> reset(rst: 0) =
        if frame_begin { 0 } else if wrote_line { ~next_wslot } else { next_wslot };
    reg(clk) lines_written: uint<9> reset(rst: 0) =
        if frame_begin { 0 } else if wrote_line { trunc(lines_written + 1) } else { lines_written };
    let last_write: uint<9> = if render_quality { 479 } else { 239 };
    let frame_complete = wrote_line && lines_written == last_write;
    reg(clk) rendering reset(rst: false) =
        if frame_begin { true } else if frame_complete { false } else { rendering };
    reg(clk) frame_done reset(rst: false) =
        if frame_complete { true } else if swap { false } else { frame_done };
    let no_meta = Meta$(valid: false, quality: false, phase: false);
    // The render buffer's contents are being replaced from the frame's start.
    reg(clk) meta: [Meta; 3] reset(rst: [no_meta, no_meta, no_meta]) =
        set_meta(set_meta(meta, rbuf, frame_begin, no_meta), rbuf, frame_complete,
                 Meta$(valid: true, quality: render_quality, phase: render_phase));

    let (busy0, busy1) = match inflight {
        Inflight::Write(s) => (s == 0, s == 1),
        _ => (false, false),
    };
    let scan_write = match (inflight, fill) {
        (Inflight::Read(s, part), Some((col, word))) => Some((part.concat(s).concat(col), word)),
        _ => None,
    };

    FbOut$(
        req: req,
        scan_write: scan_write,
        wbuf_slot: match inflight { Inflight::Write(s) => s, _ => next_wslot },
        slot_free: [wpend0.is_none() && !busy0, wpend1.is_none() && !busy1],
        may_start: !rendering && !frame_done,
        front_quality: mf.quality,
        front_phase: mf.phase,
        merge: merge,
    )
}

// 512 x 32-bit line RAM with a write port in one clock domain and a
// registered read port (one cycle latency) in another. Maps to block RAM.
pub entity line_ram(wclk: clock, write: Option<(uint<9>, uint<32>)>, rclk: clock, raddr: uint<9>) -> uint<32> {
    let w = match write {
        Some((a, d)) => (true, a, d),
        None => (false, 0u9, 0u32),
    };
    let mem: Memory<uint<32>, 512> = inst std::mem::clocked_memory(wclk, [w]);
    reg(rclk) out = inst std::mem::read_memory(mem, raddr);
    out
}

// 512 x 16-bit: half of the render line buffer (even or odd pixels).
pub entity line_ram16(wclk: clock, write: Option<(uint<9>, uint<16>)>, rclk: clock, raddr: uint<9>) -> uint<16> {
    let w = match write {
        Some((a, d)) => (true, a, d),
        None => (false, 0u9, 0u16),
    };
    let mem: Memory<uint<16>, 512> = inst std::mem::clocked_memory(wclk, [w]);
    reg(rclk) out = inst std::mem::read_memory(mem, raddr);
    out
}
