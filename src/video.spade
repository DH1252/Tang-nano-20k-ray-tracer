// 640x480 @ 60 Hz video timing and DVI 1.0 TMDS encoding.
//
// Pixel clock 25.2 MHz: 800 x 525 total -> 60.0 Hz.

pub struct Timing {
    // Column 0..799 and line 0..524 of the pixel being produced this cycle.
    x: uint<10>,
    y: uint<10>,
    active: bool,
    // Sync levels as they go on the wire (640x480 uses negative sync).
    hsync: bool,
    vsync: bool,
}

pub entity video_timing(clk: clock, rst: bool) -> Timing {
    // Reset to the last (blank) pixel so the first pixel after reset is (0, 0).
    reg(clk) x: uint<10> reset(rst: 799) = if x == 799 { 0 } else { trunc(x + 1) };
    reg(clk) y: uint<10> reset(rst: 524) =
        if x == 799 { if y == 524 { 0 } else { trunc(y + 1) } } else { y };
    Timing$(
        x: x,
        y: y,
        active: x < 640 && y < 480,
        hsync: !(x >= 656 && x < 752),
        vsync: !(y >= 490 && y < 492),
    )
}

fn popcount8(b: [bool; 8]) -> uint<4> {
    let c0: uint<4> = if b[0] { 1 } else { 0 };
    let c1: uint<4> = if b[1] { 1 } else { 0 };
    let c2: uint<4> = if b[2] { 1 } else { 0 };
    let c3: uint<4> = if b[3] { 1 } else { 0 };
    let c4: uint<4> = if b[4] { 1 } else { 0 };
    let c5: uint<4> = if b[5] { 1 } else { 0 };
    let c6: uint<4> = if b[6] { 1 } else { 0 };
    let c7: uint<4> = if b[7] { 1 } else { 0 };
    c0 +. c1 +. c2 +. c3 +. c4 +. c5 +. c6 +. c7
}

// First (transition-minimising) stage of TMDS: returns q_m[8:0].
fn tmds_qm(data: uint<8>) -> [bool; 9] {
    let d = data.as_bits();
    let n1 = popcount8(d);
    let xnor = n1 > 4 || (n1 == 4 && !d[0]);
    let q0 = d[0];
    let q1 = if xnor { !(q0 ^^ d[1]) } else { q0 ^^ d[1] };
    let q2 = if xnor { !(q1 ^^ d[2]) } else { q1 ^^ d[2] };
    let q3 = if xnor { !(q2 ^^ d[3]) } else { q2 ^^ d[3] };
    let q4 = if xnor { !(q3 ^^ d[4]) } else { q3 ^^ d[4] };
    let q5 = if xnor { !(q4 ^^ d[5]) } else { q4 ^^ d[5] };
    let q6 = if xnor { !(q5 ^^ d[6]) } else { q5 ^^ d[6] };
    let q7 = if xnor { !(q6 ^^ d[7]) } else { q6 ^^ d[7] };
    [q0, q1, q2, q3, q4, q5, q6, q7, !xnor]
}

fn bits8_to_uint(b: [bool; 9]) -> uint<8> {
    [b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]].as_uint()
}

// One TMDS channel. `ctrl` is (c1, c0) and is sent while `de` is low.
// The output symbol is registered; bit 0 is transmitted first.
pub entity tmds_encoder(clk: clock, rst: bool, data: uint<8>, ctrl: uint<2>, de: bool) -> uint<10> {
    let qm = tmds_qm(data);
    let q8 = qm[8];
    let low = bits8_to_uint(qm);
    let n1u: uint<6> = zext(popcount8([qm[0], qm[1], qm[2], qm[3], qm[4], qm[5], qm[6], qm[7]]));
    let n1: int<6> = n1u.as_int();
    let n0: int<6> = 8 -. n1;
    // n1 - n0 in [-8, 8]
    let diff: int<6> = n1 -. n0;
    let q8_2: int<6> = if q8 { 2 } else { 0 };
    let nq8_2: int<6> = if q8 { 0 } else { 2 };

    decl cnt;
    let (sym, cnt_next): (uint<10>, int<6>) = if !de {
        let s: uint<10> = match ctrl {
            0 => 0b1101010100,
            1 => 0b0010101011,
            2 => 0b0101010100,
            _ => 0b1010101011,
        };
        (s, 0)
    } else if cnt == 0 || diff == 0 {
        let s: uint<10> = if q8 {
            0b01u2.concat(low)
        } else {
            0b10u2.concat(~low)
        };
        let c = if q8 { cnt +. diff } else { cnt -. diff };
        (s, c)
    } else if (cnt > 0 && diff > 0) || (cnt < 0 && diff < 0) {
        let top: uint<2> = if q8 { 0b11 } else { 0b10 };
        (top.concat(~low), cnt +. q8_2 -. diff)
    } else {
        let top: uint<2> = if q8 { 0b01 } else { 0b00 };
        (top.concat(low), cnt -. nq8_2 +. diff)
    };
    reg(clk) cnt reset(rst: 0) = cnt_next;
    reg(clk) out reset(rst: 0b1101010100) = sym;
    out
}

pub fn rgb565_to_888(p: uint<16>) -> (uint<8>, uint<8>, uint<8>) {
    let r5: uint<5> = trunc(p >> 11);
    let g6: uint<6> = trunc(p >> 5);
    let b5: uint<5> = trunc(p);
    let r_lo: uint<3> = trunc(r5 >> 2);
    let g_lo: uint<2> = trunc(g6 >> 4);
    let b_lo: uint<3> = trunc(b5 >> 2);
    let r: uint<8> = r5.concat(r_lo);
    let g: uint<8> = g6.concat(g_lo);
    let b: uint<8> = b5.concat(b_lo);
    (r, g, b)
}
