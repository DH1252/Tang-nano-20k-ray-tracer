// Sipeed Tang Nano 20K (GW2AR-LV18QN88C8/I7) pin constraints.
// The embedded SDRAM ports (O_sdram_*, IO_sdram_dq) are placed by the
// toolchain from their names and need no entries here.

IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "btn_s1" 88;
IO_PORT "btn_s1" IO_TYPE=LVCMOS33;
IO_LOC "btn_s2" 87;
IO_PORT "btn_s2" IO_TYPE=LVCMOS33;

// USB-C UART through the BL616 (FPGA perspective)
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// LEDs, active low
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33;
IO_PORT "led[1]" IO_TYPE=LVCMOS33;
IO_PORT "led[2]" IO_TYPE=LVCMOS33;
IO_PORT "led[3]" IO_TYPE=LVCMOS33;
IO_PORT "led[4]" IO_TYPE=LVCMOS33;
IO_PORT "led[5]" IO_TYPE=LVCMOS33;

// HDMI connector (DVI)
IO_LOC "tmds_clk_p" 33;
IO_LOC "tmds_clk_n" 34;
IO_LOC "tmds_d_p[0]" 35;
IO_LOC "tmds_d_n[0]" 36;
IO_LOC "tmds_d_p[1]" 37;
IO_LOC "tmds_d_n[1]" 38;
IO_LOC "tmds_d_p[2]" 39;
IO_LOC "tmds_d_n[2]" 40;
IO_PORT "tmds_clk_p" PULL_MODE=NONE;
IO_PORT "tmds_clk_n" PULL_MODE=NONE;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE;
IO_PORT "tmds_d_n[0]" PULL_MODE=NONE;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE;
IO_PORT "tmds_d_n[1]" PULL_MODE=NONE;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE;
IO_PORT "tmds_d_n[2]" PULL_MODE=NONE;

// Expected warning: PR1014 "Generic routing resource will be used to clock
// signal 'clk_d'". The crystal on pin 4 always reaches the PLL over general
// routing in Gowin EDA, whatever the PLL site (checked with a one-PLL design
// at every legal site: PLL_L[1], PLL_R[1]; PLL_L[0] and PLL_L[2] are not
// legal on this part). The route only feeds the video PLL's reference input;
// the core PLL is cascaded from it over the clock network (rtl/gowin/clocks.v).
